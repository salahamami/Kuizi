# Kuizi local settings (T237). `make up` copies this file to .env the first time;
# edit .env, never this file, and never commit .env.
# The values below are for the local stack only. Variable names are the ones the
# cloud environment will use (T240), so application code reads the same names everywhere.

# --- PostgreSQL (cloud: Aurora PostgreSQL, T211) ---
POSTGRES_USER=kuizi
POSTGRES_PASSWORD=kuizi-local-only
POSTGRES_DB=kuizi
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kuizi:kuizi-local-only@localhost:5432/kuizi

# --- Kafka API (cloud: Amazon MSK, T021) ---
KAFKA_PORT=19092
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
SCHEMA_REGISTRY_PORT=18081
SCHEMA_REGISTRY_URL=http://localhost:18081

# --- Redis (cloud: ElastiCache, T026) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- S3 object storage (cloud: Amazon S3, T213) ---
S3_PORT=8333
S3_ENDPOINT_URL=http://localhost:8333
AWS_REGION=eu-west-3
# Static keys exist only locally. In the cloud, services use IAM roles and these stay empty.
# They are not called AWS_ACCESS_KEY_ID on purpose: AWS keys already in your shell are never used here.
S3_ACCESS_KEY_ID=kuizi-local
S3_SECRET_ACCESS_KEY=kuizi-local-secret
S3_BUCKET_MEDIA=kuizi-media
S3_BUCKET_ML_ARTIFACTS=kuizi-ml-artifacts

# --- Keycloak identity (cloud: Keycloak on EKS, T012) ---
KEYCLOAK_PORT=8080
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=kuizi
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-local-only
KEYCLOAK_DB_PASSWORD=keycloak-local-only
# Audience every Kuizi access token carries; services check it (packages/auth, docs/dev/identity.md).
KEYCLOAK_API_AUDIENCE=kuizi-api
# Google sign-in for students, optional: an OAuth client from Google Cloud (docs/dev/identity.md).
# Empty values keep the "google" identity provider switched off. Never commit real values.
KEYCLOAK_GOOGLE_CLIENT_ID=
KEYCLOAK_GOOGLE_CLIENT_SECRET=

# --- MLflow (cloud: MLflow on EKS, T218). Port 5050, because macOS uses 5000 for AirPlay. ---
MLFLOW_PORT=5050
MLFLOW_TRACKING_URI=http://localhost:5050

# --- LiteLLM gateway (optional, `make up-llm`; providers chosen in T059) ---
LITELLM_PORT=4000
LITELLM_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-kuizi-local-only
LLM_TUTOR_MODEL=
LLM_PROVIDER_API_KEY=
