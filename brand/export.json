  "rules": {
    "renderer": "Any standards-compliant SVG renderer (resvg, rsvg-convert or Inkscape). Render the whole viewBox scaled uniformly to exactly width x height pixels; never crop, pad or stretch. Every source's viewBox has the same aspect ratio as its outputs.",
    "background": "\"transparent\" keeps the alpha channel. A hex colour means: flatten onto that colour and save without an alpha channel (RGB PNG).",
    "colour": "sRGB, 8 bits per channel. Do not convert colours; the hex values in the SVGs are the Cyanotype tokens.",
    "optimise": "Lossless only (for example oxipng -o 4). No palette quantisation.",
    "check_on": "Background to look at the PNG against when checking it visually. It is not painted into the file unless \"background\" says so.",
    "paths": "Sources and outputs are relative to the repository root. Create missing folders."
  },
