{
  "realm": "kuizi",
  "displayName": "Kuizi",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginTheme": "kuizi",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr",
    "ar"
  ],
  "defaultLocale": "fr",
  "accessTokenLifespan": 900,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": true,
  "offlineSessionMaxLifespan": 5184000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxTemporaryLockouts": 0,
  "bruteForceStrategy": "MULTIPLE",
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(12) and maxLength(128) and notUsername and notEmail and pwnedPassword(1)",
  "roles": {
    "realm": [
      {
        "name": "student",
        "description": "Bac student (17-19). Under-18 accounts do nothing before parental consent (T013)."
      },
      {
        "name": "parent",
        "description": "Parent or guardian of a student."
      },
      {
        "name": "teacher",
        "description": "Teacher in a school tenant."
      },
      {
        "name": "school_admin",
        "description": "School administrator: manages the school tenant."
      },
      {
        "name": "platform_admin",
        "description": "Kuizi back-office staff, tenant 'platform'."
      },
      {
        "name": "curriculum_author",
        "description": "Writes and reviews items and the concept graph, tenant 'platform'."
      }
    ]
  },
  "clients": [
    {
      "clientId": "kuizi-api",
      "name": "Kuizi API (audience of every access token)",
      "description": "Resource server. Never signs anyone in; access tokens for Kuizi services carry aud=kuizi-api.",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "kuizi-web",
      "name": "Kuizi web app",
      "description": "Next.js web app and portals (T076). Public client, authorization code with PKCE S256.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "fullScopeAllowed": false,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*",
        "client.use.lightweight.access.token.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "true"
          }
        },
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "true",
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience kuizi-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "true",
            "included.client.audience": "kuizi-api",
            "id.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "acr",
        "profile",
        "email",
        "web-origins"
      ],
      "optionalClientScopes": []
    },
    {
      "clientId": "kuizi-mobile",
      "name": "Kuizi learner apps (iOS, Android)",
      "description": "Native apps (T163, T164). Public client, PKCE S256, app redirect scheme (RFC 8252); offline_access for long sign-ins.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "redirectUris": [
        "tn.kuizi.app:/oauth2redirect"
      ],
      "webOrigins": [],
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "tn.kuizi.app:/oauth2redirect",
        "client.use.lightweight.access.token.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "true"
          }
        },
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "true",
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience kuizi-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "true",
            "included.client.audience": "kuizi-api",
            "id.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "acr",
        "profile",
        "email",
        "web-origins"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    },
    {
      "clientId": "kuizi-dev-cli",
      "name": "Local development only: tests and smoke test",
      "description": "LOCAL ONLY. Password grant for integration tests and make smoke. Never create this client outside the local stack.",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": false,
      "protocol": "openid-connect",
      "attributes": {
        "client.use.lightweight.access.token.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "true"
          }
        },
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "true",
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience kuizi-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "lightweight.claim": "true",
            "included.client.audience": "kuizi-api",
            "id.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "basic",
        "acr",
        "profile",
        "email",
        "web-origins"
      ],
      "optionalClientScopes": []
    }
  ],
  "scopeMappings": [
    {
      "client": "kuizi-web",
      "roles": [
        "student",
        "parent",
        "teacher",
        "school_admin",
        "platform_admin",
        "curriculum_author"
      ]
    },
    {
      "client": "kuizi-mobile",
      "roles": [
        "student",
        "parent",
        "teacher",
        "school_admin",
        "platform_admin",
        "curriculum_author"
      ]
    },
    {
      "client": "kuizi-dev-cli",
      "roles": [
        "student",
        "parent",
        "teacher",
        "school_admin",
        "platform_admin",
        "curriculum_author"
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\": [{\"name\": \"username\", \"displayName\": \"${username}\", \"validations\": {\"length\": {\"min\": 3, \"max\": 255}, \"username-prohibited-characters\": {}, \"up-username-not-idn-homograph\": {}}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"email\", \"displayName\": \"${email}\", \"validations\": {\"email\": {}, \"length\": {\"max\": 255}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"firstName\", \"displayName\": \"${firstName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"lastName\", \"displayName\": \"${lastName}\", \"validations\": {\"length\": {\"max\": 255}, \"person-name-prohibited-characters\": {}}, \"required\": {\"roles\": [\"user\"]}, \"permissions\": {\"view\": [\"admin\", \"user\"], \"edit\": [\"admin\", \"user\"]}, \"multivalued\": false}, {\"name\": \"tenant_id\", \"displayName\": \"Tenant\", \"validations\": {\"pattern\": {\"pattern\": \"^[a-z0-9][a-z0-9-]{0,62}$\", \"error-message\": \"Tenant IDs use a-z, 0-9 and '-', 63 characters at most.\"}}, \"annotations\": {\"kuizi.note\": \"Set by admins and onboarding only; users can neither see nor edit it. Becomes the tenant_id token claim.\"}, \"permissions\": {\"view\": [\"admin\"], \"edit\": [\"admin\"]}, \"multivalued\": false}], \"groups\": [{\"name\": \"user-metadata\", \"displayHeader\": \"User metadata\", \"displayDescription\": \"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": false,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "linkOnly": false,
      "hideOnLogin": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${KEYCLOAK_GOOGLE_CLIENT_ID:}",
        "clientSecret": "${KEYCLOAK_GOOGLE_CLIENT_SECRET:}",
        "defaultScope": "openid email profile",
        "syncMode": "IMPORT",
        "guiOrder": "1"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "new Google accounts are students",
      "identityProviderAlias": "google",
      "identityProviderMapper": "oidc-hardcoded-role-idp-mapper",
      "config": {
        "syncMode": "IMPORT",
        "role": "student"
      }
    },
    {
      "name": "new Google accounts join the individual tenant",
      "identityProviderAlias": "google",
      "identityProviderMapper": "hardcoded-attribute-idp-mapper",
      "config": {
        "syncMode": "IMPORT",
        "attribute": "tenant_id",
        "attribute.value": "individual"
      }
    }
  ]
}
