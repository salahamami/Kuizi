{
  "name": "@kuizi/auth",
  "version": "0.1.0",
  "private": true,
  "description": "Verifies Keycloak access tokens for Kuizi services: signature, issuer, audience, expiry, tenant_id and roles (T012)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "jose": "^6.2.12"
  }
}
