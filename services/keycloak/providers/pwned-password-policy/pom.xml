<?xml version="1.0" encoding="UTF-8"?>
<!--
  Kuizi Keycloak password policy: rejects passwords found in Have I Been Pwned, using the
  k-anonymity range API (only the first 5 characters of the SHA-1 hash leave Keycloak). T012.
  Built inside the Keycloak image (services/keycloak/Dockerfile); no Java needed on the PC.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>kuizi</groupId>
  <artifactId>kuizi-pwned-password-policy</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>Kuizi pwned-password policy for Keycloak</name>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Keep in step with the Keycloak image tag in ../../Dockerfile. -->
    <keycloak.version>26.8.1</keycloak.version>
    <!-- Versions bundled in the Keycloak 26.8.1 image (/opt/keycloak/lib/lib/main). -->
    <httpclient.version>4.5.14</httpclient.version>
    <jboss-logging.version>3.6.3.Final</jboss-logging.version>
    <junit.version>5.11.4</junit.version>
  </properties>

  <dependencies>
    <!-- Everything below "provided" is already inside Keycloak; the jar ships only our classes. -->
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-server-spi</artifactId>
      <version>${keycloak.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <!-- PasswordPolicyProviderFactory and HttpClientProvider live in the "private" SPI jar. -->
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-server-spi-private</artifactId>
      <version>${keycloak.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.keycloak</groupId>
      <artifactId>keycloak-core</artifactId>
      <version>${keycloak.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.httpcomponents</groupId>
      <artifactId>httpclient</artifactId>
      <version>${httpclient.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.jboss.logging</groupId>
      <artifactId>jboss-logging</artifactId>
      <version>${jboss-logging.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>kuizi-pwned-password-policy</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
      </plugin>
    </plugins>
  </build>
</project>
